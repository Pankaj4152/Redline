# Redline Backend Environment Variables
APP_NAME=Redline Backend
APP_ENV=development
DEBUG=True
PORT=8000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Execution Mode
USE_MOCK_LLM=True

# Gemini API Key (Required when USE_MOCK_LLM=False)
GEMINI_API_KEY=your_gemini_api_key_here

# Security Limits
MAX_REPO_SIZE_MB=50
MAX_TOKEN_BUDGET=15000
